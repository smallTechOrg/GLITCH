  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "expo start --web --port 8092",
    "web": "expo start --web --port 8092",
    "typecheck": "tsc --noEmit",
