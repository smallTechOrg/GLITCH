    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "fast-png": "^8.0.0",
    "react": "19.3.0",
