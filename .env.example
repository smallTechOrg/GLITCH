# GLITCH — environment variables.
# Copy to the repo-root .env (gitignored) and fill in what you need:
#     cp .env.example .env
# The API reads the repo-root .env no matter which directory it is started from.
# Placeholder values only — never commit a real key.

# ---------------------------------------------------------------------------
# API (api/, prefix GLITCH_)
# ---------------------------------------------------------------------------

# dev | prod. In prod the fake demo provider is refused at startup.
GLITCH_ENV=dev
# Bind address. The Dockerfile sets 0.0.0.0.
GLITCH_HOST=127.0.0.1
# API port. If unset and PORT is set (Cloud Run), PORT wins.
GLITCH_PORT=8787
# auto | openrouter | fake. auto = openrouter when the key is set, else fake (DEMO NOVA).
GLITCH_LLM_PROVIDER=auto
# Secret. Get one at https://openrouter.ai/keys . Leave blank to run the demo provider.
# Without it every [live] gate step is PENDING-KEY.
GLITCH_OPENROUTER_API_KEY=
# Primary model slug (verify with: cd api && uv run python -m glitch_api.tools.check_model).
GLITCH_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Comma-separated fallback slugs OpenRouter tries inside the same call; empty = none.
GLITCH_OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini
GLITCH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# json_schema | json_object (use json_object for models without JSON-schema support).
GLITCH_OPENROUTER_RESPONSE_FORMAT=json_schema
# Sent to OpenRouter as HTTP-Referer (X-Title: GLITCH).
GLITCH_APP_URL=https://smalltechorg.github.io/GLITCH/
# Total provider budget per call, seconds (the client aborts at 8 s).
GLITCH_LLM_TIMEOUT_S=7.0
GLITCH_LLM_MAX_OUTPUT_TOKENS=700
# Live-AI actions per device per UTC day.
GLITCH_DEVICE_DAILY_CAP=10
# Provider calls per UTC day, server-wide.
GLITCH_GLOBAL_DAILY_CAP=500
# Comma-separated exact browser origins allowed by CORS.
GLITCH_CORS_ORIGINS=https://smalltechorg.github.io,http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:8092,http://localhost:8092
# DEBUG | INFO | WARNING | ERROR
GLITCH_LOG_LEVEL=INFO
# Optional: also append JSON log lines to this file (E2E uses web/test-results/api.log).
GLITCH_LOG_FILE=
# Fake provider delay in ms (tests only).
GLITCH_FAKE_LATENCY_MS=0

# Phase 2: shared blob store (scenario cache "generate once, reuse forever"; durable caps).
# local | gcs
GLITCH_BLOB_BACKEND=local
# Local blob root when GLITCH_BLOB_BACKEND=local (gitignored). Relative = from the repo root.
GLITCH_CACHE_DIR=api/.cache
# Bucket name, required when GLITCH_BLOB_BACKEND=gcs (uses Application Default Credentials).
GLITCH_GCS_BUCKET=
# Optional key prefix inside the bucket / cache dir (e.g. "staging"); empty = none.
GLITCH_BLOB_PREFIX=

# ---------------------------------------------------------------------------
# Web (web/) — EXPO_PUBLIC_* values are inlined into the static export at build time,
# so set them in the shell of the `npx expo export` command (they are not secrets).
# ---------------------------------------------------------------------------

# API base URL the exported app calls. Production export: the Cloud Run URL.
EXPO_PUBLIC_GLITCH_API_URL=http://127.0.0.1:8787
# Port of web/scripts/serve-export.mjs (static export server).
GLITCH_WEB_PORT=8090
# fake | openrouter — Playwright asserts /healthz reports this provider before running.
GLITCH_E2E_EXPECT_PROVIDER=fake

# ---------------------------------------------------------------------------
# Test tooling (Playwright E2E, web/e2e/helpers/config.ts) — read from the shell of the
# `npx playwright test` command; leave commented to use the defaults.
# ---------------------------------------------------------------------------

# Port the E2E run starts its own API on (default 8787). Use a side port (e.g. 8788) to
# leave a dev server on 8787 untouched; the export must be built with
# EXPO_PUBLIC_GLITCH_API_URL=http://127.0.0.1:<this port> (globalSetup fails on a mismatch).
# Artefacts (api.log for check_logs, blob-cache, Playwright output) go to web/test-results/
# on 8787 and to web/test-results/<port>/ on any other port.
# GLITCH_E2E_API_PORT=8787
# Export dir the E2E (and web/scripts/serve-export.mjs) serves, relative to web/ or absolute
# (default dist). Build a separate one (`npx expo export --platform web --output-dir dist-e2e`)
# so the E2E export never overwrites a dist another server is serving.
# GLITCH_WEB_DIST=dist
# 1 = reuse an API / export server already listening on the E2E ports instead of starting
# fresh ones (default: never reuse — a taken port fails the run, so it never silently tests
# someone else's server).
# GLITCH_E2E_REUSE_SERVERS=
